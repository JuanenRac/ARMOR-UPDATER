      "column": 0,
      "level": "external",
      "title": "GitHub",
      "lines": [
        "the public repositories of the",
        "account: API, raw files and git;",
        "GITHUB_TOKEN is optional"
      ]
    },
    {
      "id": "detect",
      "column": 1,
      "level": "tested",
      "title": "detect.py + github_client.py",
      "lines": [
        "local and remote discovery with",
        "no fixed list; 10 s timeout,",
        "3 retries, 8 at a time"
      ],
      "code": [
        "src/armor_updater/detect.py",
        "src/armor_updater/github_client.py"
      ],
      "title_size": 12
    },
