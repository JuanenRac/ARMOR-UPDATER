{
  "repo": "ARMOR-UPDATER",
  "ecosystem": "armor",
  "tagline": "Finds the family on this PC, compares it with GitHub and installs or updates one project at a time, verified before anything is replaced.",
  "description": "ARMOR-UPDATER discovers the A.R.M.O.R. repositories of a workspace by their armor.project.json and, remotely, of the account on GitHub; compares versions; builds and verifies every install or update in an independent staging clone; checks the signature of the revision against pinned keys; and promotes it with two journalled renames, keeping the replaced checkout as a backup and an evidence line for every attempt. It has a command line and an optional Qt Quick window.",
  "columns": [
    "WHAT IT LOOKS AT",
    "THE UPDATER",
    "WHAT IT CHANGES"
  ],
  "nodes": [
    {
      "id": "person",
      "column": 0,
      "level": "external",
      "title": "A person",
      "lines": [
        "at the terminal (armor-updater",
        "--cli) or in the Qt Quick",
        "window, in eight languages"
      ]
    },
    {
      "id": "workspace",
      "column": 0,
      "level": "external",
      "title": "The workspace",
      "lines": [
        "the folders that carry a valid",
        "armor.project.json with",
        "ecosystem A.R.M.O.R."
      ]
    },
    {
